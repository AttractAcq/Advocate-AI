:8080 {
	root * /srv
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
	}
	handle /api/* {
		reverse_proxy core:18100
	}
	handle /console-config.json {
		header Cache-Control "no-store"
		file_server
	}
	handle {
		try_files {path} /index.html
		file_server
	}
}
